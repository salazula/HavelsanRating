# PostgreSQL (Neon: Vercel-Neon entegrasyonu ikisini de otomatik tanımlar)
DATABASE_URL="postgresql://kullanici:sifre@sunucu/veritabani?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://kullanici:sifre@sunucu/veritabani?sslmode=require"

# Oturum imzası için uzun rastgele bir değer (ör. `openssl rand -base64 32`)
AUTH_SECRET="uzun-rastgele-bir-deger"




# Sitenin adresi (Telegram mesajındaki bağlantı için; boşsa Vercel adresi kullanılır)
SITE_URL=""

# Telegram: grup tamamlanınca sonuçlar kanala gönderilir (bot kanala yönetici olarak eklenmeli)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Vercel Blob (Storage > Blob eklenince otomatik tanımlanır; yoksa fotoğraflar uploads/ klasörüne yazılır)
BLOB_READ_WRITE_TOKEN=""

# Günlük otomatik fikstür kontrolü için Vercel Cron anahtarı (isteğe bağlı)
CRON_SECRET=""
